---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
import { u } from '@/utils/url';
---

<Base title="About" description={`About ${site.name} — ${site.description}`}>
  <div class="about-page container">

    <!-- Page header -->
    <header class="page-header reveal">
      <p class="section-label">About</p>
      <h1 class="page-title">A bit about me.</h1>
    </header>

    <div class="about-layout">
      <!-- Main bio column -->
      <div class="about-bio">
        <div class="about-photo reveal" aria-hidden="true">
          <div class="photo-placeholder">
            <span class="photo-placeholder__initials">JE</span>
          </div>
          <p class="photo-caption">Edinburgh, Scotland</p>
        </div>

        <div class="bio-block reveal">
          <p class="bio-text">{site.about.intro}</p>
        </div>

        <div class="bio-block reveal">
          <p class="bio-text">{site.about.approach}</p>
        </div>

        <div class="bio-block reveal">
          <p class="bio-text">{site.about.outside}</p>
        </div>

        <div class="bio-ctas reveal">
          <a href={u('/projects')} class="cta-link">
            See my work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href={`mailto:${site.email}`} class="cta-link">
            Get in touch
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Sidebar: timeline + interests -->
      <aside class="about-sidebar">
        <!-- Timeline -->
        <div class="reveal">
          <p class="section-label">Experience</p>
          <ol class="timeline">
            {site.about.timeline.map((entry) => (
              <li class="timeline-entry">
                <span class="timeline-year">{entry.year}</span>
                <div class="timeline-content">
                  <p class="timeline-role">{entry.role}</p>
                  <p class="timeline-place">{entry.place}</p>
                  <p class="timeline-desc">{entry.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Interests -->
        <div class="reveal">
          <p class="section-label" style="margin-top: var(--sp-12);">Currently into</p>
          <ul class="interests-list">
            {site.about.interests.map((interest) => (
              <li class="interest-item">
                <span class="interest-dot" aria-hidden="true"></span>
                {interest}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-block: var(--sp-16) var(--sp-24);
  }

  /* ── Page header ──────────────────────────────────────────────── */
  .page-header {
    margin-bottom: var(--sp-16);
    padding-bottom: var(--sp-12);
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    color: var(--text);
    margin-top: var(--sp-4);
  }

  /* ── Layout ───────────────────────────────────────────────────── */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-16);
  }

  @media (min-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr 360px;
      align-items: start;
      gap: var(--sp-24);
    }
  }

  /* ── Photo placeholder ────────────────────────────────────────── */
  .about-photo {
    margin-bottom: var(--sp-10);
  }

  .photo-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-3);
    /* Replace with <img> when you have a photo */
  }

  .photo-placeholder__initials {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .photo-caption {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  /* ── Bio ──────────────────────────────────────────────────────── */
  .bio-block {
    margin-bottom: var(--sp-6);
  }

  .bio-text {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .bio-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-10);
    padding-top: var(--sp-10);
    border-top: 1px solid var(--border);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--text);
    transition: color var(--ease-fast), gap var(--ease-fast);
  }

  .cta-link:hover {
    color: var(--accent);
    gap: var(--sp-3);
  }

  /* ── Timeline ─────────────────────────────────────────────────── */
  .timeline {
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border);
  }

  .timeline-entry {
    padding-left: var(--sp-6);
    padding-bottom: var(--sp-8);
    position: relative;
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong);
    border: 2px solid var(--bg);
  }

  .timeline-year {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-bottom: var(--sp-2);
    font-variant-numeric: tabular-nums;
  }

  .timeline-role {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--text);
    margin-bottom: 2px;
  }

  .timeline-place {
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  /* ── Interests ────────────────────────────────────────────────── */
  .interests-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .interest-item {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .interest-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
</style>
