---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { u } from '@/utils/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, description, type, tech, year, url, color, colorText } = project.data;
---

<Base title={title} description={description}>
  <article class="project-detail container">

    <!-- Back navigation -->
    <nav class="breadcrumb reveal" aria-label="Breadcrumb">
      <a href={u('/projects')} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        All projects
      </a>
    </nav>

    <!-- Hero visual -->
    <div
      class="project-hero reveal"
      style={`background-color: ${color ?? '#2D4A6B'};`}
      role="img"
      aria-label={`${title} project`}
    >
      <div class:list={['project-hero__title', { 'project-hero__title--dark': colorText === 'dark' }]}>
        {title}
      </div>
    </div>

    <!-- Meta row -->
    <div class="project-meta reveal">
      <div class="meta-group">
        <span class="meta-label">Type</span>
        <span class="meta-value type-badge">{type}</span>
      </div>
      <div class="meta-group">
        <span class="meta-label">Year</span>
        <span class="meta-value">{year}</span>
      </div>
      <div class="meta-group">
        <span class="meta-label">Stack / Medium</span>
        <div class="meta-tags">
          {tech.map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>
      {url && (
        <div class="meta-group">
          <span class="meta-label">Link</span>
          <a
            href={url}
            class="meta-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit project
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
            </svg>
          </a>
        </div>
      )}
    </div>

    <hr class="divider" />

    <!-- Body -->
    <div class="project-body reveal">
      <Content />
    </div>

    <!-- Next: link back -->
    <div class="project-footer reveal">
      <a href={u('/projects')} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        Back to all projects
      </a>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding-block: var(--sp-10) var(--sp-24);
    max-width: 860px;
  }

  /* ── Breadcrumb ───────────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    margin-bottom: var(--sp-8);
    transition: color var(--ease-fast), gap var(--ease-fast);
  }

  .back-link:hover {
    color: var(--text);
    gap: var(--sp-3);
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .project-hero {
    aspect-ratio: 2 / 1;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: flex-end;
    padding: var(--sp-8);
    margin-bottom: var(--sp-8);
    position: relative;
    overflow: hidden;
  }

  .project-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.2) 100%);
  }

  .project-hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.92);
    line-height: var(--leading-tight);
    position: relative;
    z-index: 1;
    max-width: 14ch;
  }

  .project-hero__title--dark {
    color: rgba(0, 0, 0, 0.75);
  }

  /* ── Meta ─────────────────────────────────────────────────────── */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8);
    margin-bottom: var(--sp-8);
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .meta-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .meta-value {
    font-size: var(--text-sm);
    color: var(--text);
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }

  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--accent);
    transition: color var(--ease-fast);
  }

  .meta-link:hover {
    color: var(--accent-hover);
  }

  /* ── Body prose ───────────────────────────────────────────────── */
  .project-body {
    max-width: var(--content-width);
  }

  .project-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: var(--weight-normal);
    letter-spacing: -0.02em;
    color: var(--text);
    margin-top: var(--sp-10);
    margin-bottom: var(--sp-4);
  }

  .project-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: var(--weight-normal);
    color: var(--text);
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-3);
  }

  .project-body :global(p) {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--text-muted);
    margin-bottom: var(--sp-5);
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-left: var(--sp-6);
    margin-bottom: var(--sp-5);
  }

  .project-body :global(li) {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--text-muted);
    margin-bottom: var(--sp-2);
    list-style: disc;
  }

  .project-body :global(strong) {
    font-weight: var(--weight-semi);
    color: var(--text);
  }

  .project-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    transition: border-color var(--ease-fast);
  }

  .project-body :global(a:hover) {
    border-color: var(--accent);
  }

  .project-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--sp-6);
    margin-block: var(--sp-6);
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Footer ───────────────────────────────────────────────────── */
  .project-footer {
    padding-top: var(--sp-12);
    margin-top: var(--sp-16);
    border-top: 1px solid var(--border);
  }

  .project-footer .back-link {
    margin-bottom: 0;
  }
</style>
