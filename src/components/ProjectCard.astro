---
import { u } from '@/utils/url';

interface Props {
  title: string;
  description: string;
  type: string;
  tech: string[];
  year: number;
  slug: string;
  url?: string;
  color?: string;
  colorText?: 'light' | 'dark';
  featured?: boolean;
}

const {
  title,
  description,
  type,
  tech,
  year,
  slug,
  url,
  color = '#2D4A6B',
  colorText = 'light',
  featured = false,
} = Astro.props;

// Internal detail page always exists; external URL used as secondary link
const href = u(`/projects/${slug}`);
---

<article class:list={['project-card', { 'project-card--featured': featured }]}>
  <a href={href} class="project-card__link" aria-label={`View ${title}`}>
    <div
      class="project-card__visual"
      style={`background-color: ${color};`}
      aria-hidden="true"
    >
      <span class:list={['project-card__visual-title', { 'project-card__visual-title--dark': colorText === 'dark' }]}>
        {title}
      </span>
    </div>

    <div class="project-card__body">
      <div class="project-card__meta">
        <span class="type-badge">{type}</span>
        <span class="project-card__year">{year}</span>
      </div>
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__desc">{description}</p>
      <div class="project-card__tech">
        {tech.slice(0, 3).map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </div>
  </a>

  {url && (
    <a
      href={url}
      class="project-card__external"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Visit ${title} (opens in new tab)`}
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
      Visit
    </a>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--ease-base),
      box-shadow var(--ease-base),
      transform var(--ease-base);
    position: relative;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card__visual {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: flex-end;
    padding: var(--sp-4);
    position: relative;
    overflow: hidden;
  }

  /* Subtle texture overlay */
  .project-card__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(0,0,0,0.15) 100%);
  }

  .project-card__visual-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-normal);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
    color: rgba(255, 255, 255, 0.9);
    position: relative;
    z-index: 1;
  }

  .project-card__visual-title--dark {
    color: rgba(0, 0, 0, 0.75);
  }

  .project-card__body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .project-card__year {
    font-size: var(--text-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .project-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-normal);
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: var(--leading-snug);
  }

  .project-card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
    flex: 1;
    /* Clamp to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-2);
  }

  .project-card__external {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: rgba(255, 255, 255, 0.75);
    background: rgba(0, 0, 0, 0.25);
    padding: 0.3em 0.7em;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
    transition: color var(--ease-fast), background-color var(--ease-fast);
    z-index: 2;
  }

  .project-card__external:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
  }

  /* Featured variant — larger visual */
  .project-card--featured .project-card__visual {
    aspect-ratio: 3 / 2;
  }
</style>
